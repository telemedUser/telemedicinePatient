{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telemedicine.bupa/schemas/events/ConsultationContextPublished/1.0",
  "type": "object",
  "required": [
    "appointmentId",
    "patientDisplay",
    "ageYears",
    "sexCode",
    "city",
    "insuranceScheme",
    "nationalIdMasked",
    "modality",
    "visitType",
    "scheduledAt",
    "severityScore",
    "symptomDurationCode",
    "symptomCount",
    "attachmentCount",
    "redFlag",
    "consultationFeeMinor",
    "voucherMinor",
    "amountPaidMinor",
    "currency",
    "paymentStatus",
    "clinicalContextJson",
    "publishedAt"
  ],
  "properties": {
    "appointmentId": { "type": "string" },
    "patientDisplay": { "type": "string" },
    "ageYears": { "type": "integer" },
    "sexCode": { "type": ["string", "null"] },
    "city": { "type": ["string", "null"] },
    "insuranceScheme": { "type": ["string", "null"] },
    "nationalIdMasked": { "type": ["string", "null"] },
    "modality": { "type": "string" },
    "visitType": { "type": "string" },
    "scheduledAt": { "type": "string", "format": "date-time" },
    "severityScore": { "type": "integer" },
    "symptomDurationCode": { "type": ["string", "null"] },
    "symptomCount": { "type": "integer" },
    "attachmentCount": { "type": "integer" },
    "redFlag": { "type": "boolean" },
    "consultationFeeMinor": { "type": "integer" },
    "voucherMinor": { "type": "integer" },
    "amountPaidMinor": { "type": "integer" },
    "currency": { "type": "string" },
    "paymentStatus": { "type": "string" },
    "clinicalContextJson": { "type": "string" },
    "publishedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
