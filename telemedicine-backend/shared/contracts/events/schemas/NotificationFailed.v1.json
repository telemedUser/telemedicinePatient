    "appointmentId": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "templateId": {
      "type": "string"
    },
    "reasonCode": {
      "type": "string"
    },
    "failedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
