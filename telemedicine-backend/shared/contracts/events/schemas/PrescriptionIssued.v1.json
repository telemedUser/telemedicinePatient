{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telemedicine.bupa/schemas/events/PrescriptionIssued/1.0",
  "type": "object",
  "required": [
    "appointmentId",
    "prescriptionId",
    "provider",
    "physicianRef",
    "issuedAt"
  ],
  "properties": {
    "appointmentId": {
      "type": "string"
    },
    "prescriptionId": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "physicianRef": {
      "type": "string"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
