{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telemedicine.bupa/schemas/events/SurveyCompleted/1.0",
  "type": "object",
  "required": [
    "appointmentId",
    "surveyId",
    "score",
    "completedAt"
  ],
  "properties": {
    "appointmentId": {
      "type": "string"
    },
    "surveyId": {
      "type": "string"
    },
    "score": {
      "type": "integer"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
