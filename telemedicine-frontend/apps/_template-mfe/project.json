{
  "name": "template-mfe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/_template-mfe/src",
  "projectType": "application",
  "tags": ["scope:app", "type:mfe"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/template-mfe"],
      "options": {
        "command": "vite build",
        "cwd": "apps/_template-mfe"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/_template-mfe"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "apps/_template-mfe"
      }
    }
  }
}
