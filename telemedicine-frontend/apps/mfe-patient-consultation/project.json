{
  "name": "mfe-patient-consultation",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mfe-patient-consultation/src",
  "projectType": "application",
  "tags": [
    "scope:app",
    "type:mfe"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/mfe-patient-consultation"
      ],
      "options": {
        "command": "vite build",
        "cwd": "apps/mfe-patient-consultation"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/mfe-patient-consultation"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "apps/mfe-patient-consultation"
      }
    }
  }
}
