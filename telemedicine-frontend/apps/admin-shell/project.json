{
  "name": "admin-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/admin-shell/src",
  "projectType": "application",
  "tags": [
    "scope:app",
    "type:admin-shell"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/admin-shell"
      ],
      "options": {
        "command": "vite build",
        "cwd": "apps/admin-shell"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/admin-shell"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "apps/admin-shell"
      }
    }
  }
}
