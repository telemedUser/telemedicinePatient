VITE_AUTH_MODE=dev
VITE_OBSERVABILITY_MODE=dev
VITE_BOOKING_BASE_PATH=/booking
VITE_USE_MOCKS=false

# --- Video consultation (WebRTC) ---
# Signaling server (video-consultation-service). Must match the physician app's VITE_VIDEO_WS_URL
# so both sides join the same room. Default localhost:8130 for single-machine dev; for cross-network
# set to the signaling host's reachable address (wss:// behind TLS).
VITE_VIDEO_WS_URL=ws://localhost:8130/ws

# ICE servers for NAT traversal (works across networks, not just LAN). STUN default covers most NATs.
# VITE_STUN_URL=stun:stun.l.google.com:19302
# TURN relay — required for restrictive/symmetric NATs (deploy coturn and set these):
# VITE_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# VITE_TURN_USERNAME=telemedicine
# VITE_TURN_CREDENTIAL=change-me
