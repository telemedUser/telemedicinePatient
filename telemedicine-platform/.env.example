# Telemedicine Platform — local environment contract
# Copy to .env:  cp .env.example .env   (or: make env)

COMPOSE_PROJECT_NAME=telemedicine
COMPOSE_PROFILES=infra,observability,sim,edge,platform

# --- Image tags (pinned; no :latest) ---
CONSUL_IMAGE=hashicorp/consul:1.19
POSTGRES_IMAGE=postgres:16.4-alpine
REDIS_IMAGE=redis:7.4-alpine
KAFKA_IMAGE=bitnamilegacy/kafka:3.7.0
MINIO_IMAGE=minio/minio:RELEASE.2024-09-22T00-33-43Z
MINIO_MC_IMAGE=minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:25.0
PROMETHEUS_IMAGE=prom/prometheus:v2.54.0
JAEGER_IMAGE=jaegertracing/all-in-one:1.57
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.0

# --- Host port bindings ---
CONSUL_PORT=8500
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_INTERNAL_PORT=9092
KAFKA_HOST_PORT=29092
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
KEYCLOAK_PORT=8180
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
ELASTICSEARCH_PORT=9200
GATEWAY_PORT=8080
SIMULATORS_PORT=8200
SHELL_PORT=3000
TEMPLATE_MFE_PORT=3001

# --- Credentials (change for non-local use) ---
POSTGRES_USER=telemedicine
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=telemedicine
REDIS_PASSWORD=change-me-locally
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-locally
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally
KEYCLOAK_REALM=telemedicine

# --- Application wiring (used by gateway / future services) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3010,http://localhost:3020
KAFKA_BOOTSTRAP=kafka:9092
REDIS_HOST=redis
REDIS_PORT_INTERNAL=6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
KEYCLOAK_JWK_URI=http://keycloak:8080/realms/telemedicine/protocol/openid-connect/certs
SPRING_PROFILES_ACTIVE=dev
